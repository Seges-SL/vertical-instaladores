{
  "permissions": {
    "allow": [
      "Bash(pylint *)",
      "Bash(ruff check *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python3 -m py_compile *)",
      "Bash(xmllint --noout *)",
      "Bash(python3 ~/.claude/hooks/odoo_lint.py --revisar *)",
      "Bash(odoo-dev *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Read(./.env)",
      "Read(./**/.env)"
    ],
    "additionalDirectories": [
      "/opt/odoo-src/17.0",
      "/opt/odoo-src/14.0",
      "/opt/odoo-src/migracion"
    ],
    "ask": [
      "Bash(odoo-dev 14 bd-cargar *)",
      "Bash(odoo-dev 17 bd-cargar *)"
    ]
  }
}
